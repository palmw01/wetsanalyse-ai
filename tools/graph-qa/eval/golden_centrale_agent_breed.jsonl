# Aanvulling op de agentset (ADR-016 §A6, vanaf de ronde na A2-2): opdrachten die meten of de overdracht naar de brede
# toolset (`meer_tools`) valt waar ze moet. De centrale agent begint met een kernset; geldigheid, grondslagen en wie naar
# een bepaling verwijst zitten erbuiten (B01-B03). B04 is de controle: de opbouw van een regeling staat in de kernset, dus
# daar hoort de overdracht niet te vallen. Een eigen bestand en een eigen groep (`breed`), zodat de 30 opdrachten van
# `golden_centrale_agent.jsonl` en de vergelijking met de nulmeting ongewijzigd blijven. Dezelfde velden als daar.
{"id": "B01", "groep": "breed", "opdracht": "Gold artikel 28 van de Invorderingswet 1990 in zijn huidige tekst ook al op 1 januari 2020?", "verwacht": {"route": "centraal", "route_code": null, "subagents": [0, 0], "profielen": [], "tools_verplicht": ["meer_tools", "geldigheid"], "tools_verboden": ["subagent"], "vraag_omhoog": null, "sjabloon": "antwoord_duiding|antwoord_bepaling", "bevestiging": false, "regisseur": false}, "stoppunt": "einde", "goed": "De datum waarop de huidige tekst van artikel 28 in werking trad, uit de graaf, en daaruit ja of nee voor 1 januari 2020; met de grens dat de graaf één toestand kent en een eerdere tekst niet toont. Geen datum uit eigen kennis.", "bron": [{"bwb_id": "BWBR0004770", "artikel": "28"}]}
{"id": "B02", "groep": "breed", "opdracht": "Welke regelingen in de kennisgraaf berusten op de Invorderingswet 1990, en op welke artikelen?", "verwacht": {"route": "centraal", "route_code": null, "subagents": [0, 0], "profielen": [], "tools_verplicht": ["meer_tools", "grondslagen"], "tools_verboden": ["subagent"], "vraag_omhoog": null, "sjabloon": "antwoord_duiding|antwoord_bepaling", "bevestiging": false, "regisseur": false}, "stoppunt": "einde", "goed": "De regelingen die de graaf als gedelegeerd op de Invorderingswet 1990 kent, elk met de bepaling waarop ze berust, uit de tool; geen regeling of artikel dat de graaf niet noemt, en de grens dat alleen regelingen in de graaf meetellen."}
{"id": "B03", "groep": "breed", "opdracht": "Welke bepalingen verwijzen naar artikel 22bis van de Invorderingswet 1990?", "verwacht": {"route": "centraal", "route_code": null, "subagents": [0, 0], "profielen": [], "tools_verplicht": ["meer_tools", "verwijst_naar_deze|referenced_by"], "tools_verboden": ["subagent"], "vraag_omhoog": null, "sjabloon": "antwoord_duiding|antwoord_bepaling", "bevestiging": false, "regisseur": false}, "stoppunt": "einde", "goed": "De bepalingen die de graaf als verwijzend naar artikel 22bis kent (binnen de wet en in de Leidraad), met vindplaats; of het compleet is staat erbij. Geen verwijzing die de tool niet gaf.", "bron": [{"bwb_id": "BWBR0004770", "artikel": "22bis"}]}
{"id": "B04", "groep": "breed", "opdracht": "Hoe is hoofdstuk IV van de Invorderingswet 1990 opgebouwd, en welke artikelen vallen onder elke afdeling?", "verwacht": {"route": "centraal", "route_code": null, "subagents": [0, 0], "profielen": [], "tools_verplicht": ["inhoudsopgave|zoek_opbouw"], "tools_verboden": ["subagent", "meer_tools"], "vraag_omhoog": null, "sjabloon": "antwoord_duiding|antwoord_bepaling", "bevestiging": false, "regisseur": false}, "stoppunt": "einde", "goed": "De afdelingen van hoofdstuk IV met hun opschrift en de artikelen eronder, in de volgorde van de wet (afdeling 1 met onder meer de artikelen 21 tot en met 22bis, afdeling 2 met artikel 24). De opbouw staat in de kernset: de overdracht naar de brede toolset is hier niet nodig.", "bron": [{"bwb_id": "BWBR0004770", "artikel": "21"}, {"bwb_id": "BWBR0004770", "artikel": "24"}]}
