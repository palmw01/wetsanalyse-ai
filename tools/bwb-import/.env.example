# GraphDB (RDF/SPARQL). Op Azure zet main.bicep hier de interne GraphDB van de straat.
GRAPHDB_URL=http://localhost:7200
GRAPHDB_REPOSITORY=inning
# Optioneel; leeg = anoniem (GraphDB-security uit)
GRAPHDB_USER=
GRAPHDB_PASSWORD=
# IRI-namespaces voor resources resp. de ontologie
GRAPHDB_BASE_IRI=urn:bwb:
GRAPHDB_ONTOLOGY_IRI=urn:bwb-ns:

# Standaard te importeren regeling
BWB_DEFAULT_ID=BWBR0004770

# XSD-validatie aan/uit (validatie is niet-blokkerend)
BWB_VALIDATE_XSD=true

# Optionele API-key voor de FastAPI-service (leeg = geen auth)
BWB_SERVICE_API_KEY=

# Ongetagde tekstverwijzingen ("artikel 3:2 Awb") detecteren (soort=tekstueel)
BWB_DETECT_TEKSTUELE_REFS=true

# WTI-verrijking: citeertitels/afkortingen, rechtsgebieden (skos), grondslagen
BWB_IMPORT_WTI=false
