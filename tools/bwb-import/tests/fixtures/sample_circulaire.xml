<?xml version="1.0" encoding="UTF-8"?>
<toestand bwb-id="BWBR0099999" inwerkingtreding="2020-01-01">
  <wetgeving soort="circulaire">
    <intitule>Test-circulaire</intitule>
    <citeertitel>Testleidraad 2020</citeertitel>
    <meta-data>
      <brondata>
        <oorspronkelijk>
          <publicatie soort="Stcrt">
            <publicatiejaar>2020</publicatiejaar>
            <publicatienr>1</publicatienr>
          </publicatie>
        </oorspronkelijk>
      </brondata>
    </meta-data>
    <circulaire>
      <circulaire-tekst>
        <circulaire.divisie bwb-ng-variabel-deel="/Circulaire.divisie1" label="Artikel 1"
            inwerking="2020-01-01" bron="Stcrt.2020-1" effect="nieuwe-regeling" status="goed">
          <kop><label>Artikel</label><nr>1</nr><titel>Inleiding</titel></kop>
          <tekst>
            <al>Deze leidraad ziet op
              <extref bwb-id="BWBR0004770" doc="jci1.3:c:BWBR0004770&amp;artikel=4">artikel 4
              Invorderingswet</extref>.</al>
            <lijst>
              <li>
                <li.nr>a.</li.nr>
                <al>een onderdeel met
                  <extref bwb-id="BWBR0002320" doc="jci1.3:c:BWBR0002320&amp;artikel=1">artikel 1
                  Awr</extref></al>
              </li>
            </lijst>
          </tekst>
          <circulaire.divisie bwb-ng-variabel-deel="/Circulaire.divisie1/Circulaire.divisie1.1"
              label="Artikel 1.1">
            <kop><label>Paragraaf</label><nr>1.1</nr><titel>Nadere uitwerking</titel></kop>
            <tekst>
              <al>De subtekst verwijst naar
                <extref bwb-id="BWBR0004770" doc="jci1.3:c:BWBR0004770&amp;artikel=19">artikel 19</extref>.</al>
            </tekst>
            <meta-data>
              <jcis><jci verwijzing="jci1.3:c:BWBR0099999&amp;artikel=1.1"/></jcis>
            </meta-data>
          </circulaire.divisie>
          <meta-data>
            <jcis><jci verwijzing="jci1.3:c:BWBR0099999&amp;artikel=1"/></jcis>
          </meta-data>
        </circulaire.divisie>
        <!-- Divisie 2 mengt subdivisies en een eigen <artikel>, in die volgorde: de vorm van
             /Circulaire.divisie79 in de Leidraad. De subdivisies hebben bewust GEEN eigen jci –
             dat is het #id=-fallbackpad, dat in de echte bron verreweg het vaakst voorkomt. -->
        <circulaire.divisie bwb-ng-variabel-deel="/Circulaire.divisie2" label="Artikel 2"
            inwerking="2020-01-01" bron="Stcrt.2020-1" effect="nieuwe-regeling" status="goed">
          <kop><label>Artikel</label><nr>2</nr><titel>Gemengde divisie</titel></kop>
          <tekst><al>Dit artikel beschrijft het beleid over:</al></tekst>
          <circulaire.divisie bwb-ng-variabel-deel="/Circulaire.divisie2/Circulaire.divisie2.1"
              label="2.1">
            <kop><nr>2.1</nr><titel>Eerste subdivisie</titel></kop>
            <tekst><al>Tekst van subdivisie 2.1.</al></tekst>
          </circulaire.divisie>
          <artikel bwb-ng-variabel-deel="/Circulaire.divisie2/Artikel2bis.1" label="Artikel 2bis.1"
              inwerking="2020-01-01" status="goed">
            <kop><label>Artikel</label><nr>2bis.1</nr></kop>
            <lid bwb-ng-variabel-deel="/Circulaire.divisie2/Artikel2bis.1/Lid1">
              <lidnr>1</lidnr>
              <al>Het eerste lid van het artikel in de divisie.</al>
            </lid>
            <meta-data>
              <jcis><jci verwijzing="jci1.3:c:BWBR0099999&amp;artikel=2&amp;artikel=2bis.1"/></jcis>
            </meta-data>
          </artikel>
          <circulaire.divisie bwb-ng-variabel-deel="/Circulaire.divisie2/Circulaire.divisie2.2"
              label="2.2">
            <kop><nr>2.2</nr><titel>Tweede subdivisie</titel></kop>
            <tekst><al>Tekst van subdivisie 2.2.</al></tekst>
          </circulaire.divisie>
        </circulaire.divisie>
      </circulaire-tekst>
    </circulaire>
  </wetgeving>
</toestand>
