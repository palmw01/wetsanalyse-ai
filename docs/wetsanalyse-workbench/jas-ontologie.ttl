@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix jas: <urn:jas-ns:> .
@prefix jask: <urn:jas-ns:klasse:> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

jas: a owl:Ontology ;
    rdfs:label "JAS-annotaties"@nl ;
    dcterms:description "Vocabulaire voor JAS-annotaties (activiteit 2 van de methode Wetsanalyse) op de BWB-graaf. Markeringen zijn W3C Web Annotations (oa:), herkomst staat in PROV-O."@nl .

jas:AgentRun a owl:Class ;
    rdfs:label "agent-ronde"@nl ;
    rdfs:comment "Eén beurt van Lex die markeringen voorstelde of hergebruikte."@nl .

jas:Alternatief a owl:Class ;
    rdfs:label "alternatief"@nl ;
    rdfs:comment "Een andere klasse die bij twijfel in aanmerking kwam."@nl .

jas:AnnotatieLaag a owl:Class ;
    rdfs:label "annotatielaag"@nl ;
    rdfs:comment "De gedeelde JAS-annotatie van één artikel."@nl .

jas:Beslissing a owl:Class ;
    rdfs:label "beslissing"@nl ;
    rdfs:comment "Eén oordeel van een jurist over een markering."@nl .

jas:CriticRonde a owl:Class ;
    rdfs:label "Critic-ronde"@nl ;
    rdfs:comment "Eén oordeel van de Critic over een markering."@nl .

jas:Lidstand a owl:Class ;
    rdfs:label "lidstand"@nl ;
    rdfs:comment "De versie van de wettekst van één lid waarop de laag gebaseerd is."@nl .

jas:Markering a owl:Class ;
    rdfs:label "markering"@nl ;
    rdfs:comment "Eén JAS-markering: een fragment wettekst met zijn klasse."@nl .

jas:Register a owl:Class ;
    rdfs:label "register"@nl ;
    rdfs:comment "Welke lagen er in de kennisgraaf staan, en in welke versie."@nl .

jas:aandacht a owl:ObjectProperty ;
    rdfs:label "aandacht (Critic)"@nl .

jas:aandacht-geel a skos:Concept ;
    skos:inScheme jas:aandacht-waarden ;
    skos:prefLabel "geel"@nl .

jas:aandacht-groen a skos:Concept ;
    skos:inScheme jas:aandacht-waarden ;
    skos:prefLabel "groen"@nl .

jas:aandacht-rood a skos:Concept ;
    skos:inScheme jas:aandacht-waarden ;
    skos:prefLabel "rood"@nl .

jas:actie a owl:DatatypeProperty ;
    rdfs:label "actie van de Critic"@nl .

jas:artikel a owl:DatatypeProperty ;
    rdfs:label "artikel"@nl .

jas:bepaling a owl:ObjectProperty ;
    rdfs:label "bepaling in de wet"@nl .

jas:beslissing-approve a skos:Concept ;
    skos:inScheme jas:beslissing-waarden ;
    skos:prefLabel "approve"@nl .

jas:beslissing-comment a skos:Concept ;
    skos:inScheme jas:beslissing-waarden ;
    skos:prefLabel "comment"@nl .

jas:beslissing-edit a skos:Concept ;
    skos:inScheme jas:beslissing-waarden ;
    skos:prefLabel "edit"@nl .

jas:beslissing-heropen a skos:Concept ;
    skos:inScheme jas:beslissing-waarden ;
    skos:prefLabel "heropen"@nl .

jas:beslissing-reject a skos:Concept ;
    skos:inScheme jas:beslissing-waarden ;
    skos:prefLabel "reject"@nl .

jas:beslissingType a owl:ObjectProperty ;
    rdfs:label "soort beslissing"@nl .

jas:bronHash a owl:DatatypeProperty ;
    rdfs:label "hash van het artikelcorpus"@nl .

jas:bwbId a owl:DatatypeProperty ;
    rdfs:label "BWB-id"@nl .

jas:criticRondes a owl:DatatypeProperty ;
    rdfs:label "aantal Critic-rondes"@nl .

jas:elementId a owl:DatatypeProperty ;
    rdfs:label "element-id"@nl .

jas:gewijzigdDoor a owl:DatatypeProperty ;
    rdfs:label "laatst gewijzigd door (agent of mens)"@nl .

jas:heeftAlternatief a owl:ObjectProperty ;
    rdfs:label "heeft alternatief"@nl .

jas:heeftBeslissing a owl:ObjectProperty ;
    rdfs:label "heeft beslissing"@nl .

jas:heeftCriticRonde a owl:ObjectProperty ;
    rdfs:label "heeft Critic-ronde"@nl .

jas:heeftLidstand a owl:ObjectProperty ;
    rdfs:label "heeft lidstand"@nl .

jas:herkomst a owl:DatatypeProperty ;
    rdfs:label "aangemaakt door (agent of mens)"@nl .

jas:inGraaf a owl:ObjectProperty ;
    rdfs:label "in named graph"@nl .

jas:inLaag a owl:ObjectProperty ;
    rdfs:label "in laag"@nl .

jas:klasse a owl:ObjectProperty ;
    rdfs:label "JAS-klasse"@nl .

jask:afleidingsregel a skos:Concept ;
    skos:inScheme jas:klassen ;
    skos:notation 6 ;
    skos:prefLabel "Afleidingsregel"@nl ;
    skos:topConceptOf jas:klassen .

