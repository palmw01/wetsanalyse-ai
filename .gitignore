# Dependencies
node_modules/

# Python
__pycache__/
*.pyc
.venv/
api/.venv/
.pytest_cache/

# Logs
*.log

# Build/runtime rommel
.DS_Store

# Machine-specifieke Claude Code config met secrets (tokens, paden)
.claude/settings.local.json

# Lokaal geïnstalleerde voorbeeld-skill (niet onderdeel van de repo)
.claude/skills/frontend-design/
skills-lock.json

# Lokale tooling-skill voor het maken/verbeteren van skills + zijn eval-workspaces
.claude/skills/skill-creator/
.claude/skills/*-workspace/

# Lokaal-only: bronmateriaal van derden dat niet in een publieke repo hoort.
# Het boek (Boom uitgevers, auteursrecht) en de interne readers van het Expertisecentrum BRM
# ("Bestemd voor gebruik binnen de Belastingdienst").
#
# De regels staan bewust op `docs/**` en niet op één submap. Twee keer is het misgegaan doordat
# een pad te specifiek was: eerst stond het boek als `docs/wetsanalyse-boek.md` (één niveau te
# hoog, dus de regel greep nooit en het boek stond twee weken in de publieke repo), daarna
# belandden dezelfde readers als PDF in `docs/kennisbank/`, waar `docs/wetsanalyse/*.pages.md`
# ze niet dekte. Een map kiezen is geen bescherming; de vorm van het materiaal wel.
#
# Alle PDF's onder docs/ zijn daarom standaard genegeerd: het is er zonder uitzondering
# bronmateriaal van derden (readers, het boek, de RegelSpraak- en WetsTaal-specificaties). Moet
# er ooit een PDF wél mee, voeg dan een expliciete `!`-uitzondering toe en verantwoord die.
# Wijzig je hier iets, controleer dan met `git check-ignore -v <pad>`.
docs/**/*.pdf
docs/**/wetsanalyse-boek.md
docs/**/*.pages.md

# Lokaal-only: Regelspraak-werkmateriaal (niet in de repo; valt ook al onder docs/**/*.pdf)
docs/regelspraak/

# Secrets en runtime-data van de API (.env.example blijft wél gecommit als template)
.env
.env.local
api/secrets/
api/docker-compose.override.yml
api/_data/

# Door de BWB-importer gedownloade wettekst (XML + WTI). Afgeleide data die de importer
# zelf bij overheid.nl ophaalt en als cache bewaart; hoort niet in de repo – 47 MB per
# volledige import, en de bron is de wettenbank, niet git.
tools/bwb-import/data/
api/spike_act2.json

# Lokale sqlite van de API bij een smoke-test (`api/CLAUDE.md`: sqlite-override). Wegwerpdata van
# één machine – de echte opslag is Postgres.
api/*.db

# bwb-import draait op pip; een uv.lock daar is een artefact van een `uv run` zonder --no-project.
tools/bwb-import/uv.lock
