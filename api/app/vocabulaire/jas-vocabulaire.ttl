<urn:jas-ns:regel:jas.voorwaarde.voorwaardelijke_bijzin> a jas:Detectorregel ;
    dcterms:source "H2:64" ;
    skos:prefLabel "Voorwaardelijke bijzin"@nl ;
    jas:code <urn:jas-ns:code:CONDITIONAL_CLAUSE> ;
    jas:regelVersie 1 ;
    jas:wijstAan <urn:jas-ns:klasse:Voorwaarde> .

<urn:jas-ns:regel:jas.voorwaarde.wegens> a jas:Detectorregel ;
