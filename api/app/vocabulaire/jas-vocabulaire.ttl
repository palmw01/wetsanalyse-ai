    jas:code <urn:jas-ns:code:LOGICAL> ;
    jas:regelVersie 1 ;
    jas:wijstAan <urn:jas-ns:klasse:Operator> .

<urn:jas-ns:regel:jas.operator.rekenkundig> a jas:Detectorregel ;
