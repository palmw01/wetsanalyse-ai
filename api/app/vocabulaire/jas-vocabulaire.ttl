    skos:prefLabel "Geldbedrag"@nl ;
    jas:code <urn:jas-ns:code:MONEY_AMOUNT> ;
    jas:regelVersie 1 ;
    jas:wijstAan <urn:jas-ns:klasse:ParameterEnParameterwaarde>,
        <urn:jas-ns:klasse:VariabeleEnVariabelewaarde> .

