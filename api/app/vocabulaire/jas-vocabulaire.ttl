    skos:prefLabel "Wettelijk vermoeden of fictie"@nl ;
    jas:code <urn:jas-ns:code:LEGAL_FICTION> ;
    jas:regelVersie 1 ;
    jas:wijstAan <urn:jas-ns:klasse:Afleidingsregel> .

<urn:jas-ns:regel:jas.afleiding.wordt_gesteld_op> a jas:Detectorregel ;
