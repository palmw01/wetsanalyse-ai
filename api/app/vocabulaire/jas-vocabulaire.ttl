<urn:jas-ns:besluit:model> a jas:Besluitwijze ;
    skos:definition "Het model koos uit de klassen die het patroon toeliet."@nl ;
    skos:prefLabel "model"@nl ;
    jas:codeWaarde "model" .

<urn:jas-ns:besluit:regel> a jas:Besluitwijze ;
    skos:definition "Besloten zonder model: één klasse mogelijk en sterk bewijs."@nl ;
    skos:prefLabel "vaste regel"@nl ;
    jas:codeWaarde "regel" .

<urn:jas-ns:besluit:specificiteit> a jas:Besluitwijze ;
    skos:definition "Besloten door een JAS-voorrangsregel over overlappende fragmenten."@nl ;
    skos:prefLabel "voorrangsregel"@nl ;
    jas:codeWaarde "specificiteit" .

<urn:jas-ns:classifier:CLASSIFIER_CONTRACT_ERROR> a jas:Classifiercode ;
    skos:definition "Het model koos buiten wat voor dit fragment was toegestaan. Dat is een contractfout, geen juridische twijfel; de afhandeling is die van een onbesliste classificatie."@nl ;
    skos:prefLabel "Technische storing van het model"@nl ;
    jas:codeWaarde "CLASSIFIER_CONTRACT_ERROR" .

<urn:jas-ns:classifier:CLASSIFIER_GEEN_UITVOER> a jas:Classifiercode ;
    skos:definition "Het model antwoordde niet via het hulpmiddel."@nl ;
    skos:prefLabel "Geen uitvoer van het model"@nl ;
    jas:codeWaarde "CLASSIFIER_GEEN_UITVOER" .

<urn:jas-ns:classifier:CLASSIFIER_OMITTED> a jas:Classifiercode ;
    skos:definition "Het model liet deze kandidaat weg."@nl ;
    skos:prefLabel "Overgeslagen door het model"@nl ;
    jas:codeWaarde "CLASSIFIER_OMITTED" .

<urn:jas-ns:classifier:CLASSIFIER_ONGELDIGE_KLASSE> a jas:Classifiercode ;
    skos:definition "Het model koos een klasse die voor deze kandidaat niet mocht."@nl ;
    skos:prefLabel "Niet-toegestane klasse"@nl ;
    jas:codeWaarde "CLASSIFIER_ONGELDIGE_KLASSE" .

<urn:jas-ns:classifier:CLASSIFIER_ONGELDIGE_OPTIE> a jas:Classifiercode ;
    skos:definition "Het model koos een grens die niet werd aangeboden."@nl ;
    skos:prefLabel "Niet-bestaande grens"@nl ;
    jas:codeWaarde "CLASSIFIER_ONGELDIGE_OPTIE" .

<urn:jas-ns:classifier:VALIDATION_ERROR> a jas:Classifiercode ;
    skos:definition "Het voorstel haalde een structurele controle niet en is verworpen."@nl ;
    skos:prefLabel "Afgekeurd bij de validatie"@nl ;
    jas:codeWaarde "VALIDATION_ERROR" .

<urn:jas-ns:code:DEFINITION_ITEM> a jas:Detectiecode ;
    skos:definition "Een onderdeel van een begripsbepalingenartikel: 'a. X: …'."@nl ;
    skos:prefLabel "Begripsbepaling (onderdeel)"@nl ;
    jas:codeWaarde "DEFINITION_ITEM" .

<urn:jas-ns:code:DEFINITION_SENTENCE> a jas:Detectiecode ;
    skos:definition "'In deze wet wordt verstaan onder X: …'."@nl ;
    skos:prefLabel "Begripsbepaling (zin)"@nl ;
    jas:codeWaarde "DEFINITION_SENTENCE" .

<urn:jas-ns:code:ENUMERATED_NP> a jas:Detectiecode ;
    skos:definition "Een naamwoordgroep als onderdeel van een opsomming."@nl ;
    skos:prefLabel "Opsommingsonderdeel"@nl ;
    jas:codeWaarde "ENUMERATED_NP" .

<urn:jas-ns:code:MEANING_TERM> a jas:Detectiecode ;
    skos:definition "Het begrip dat in een begripsbepaling een betekenis krijgt."@nl ;
    skos:prefLabel "Begrip met betekenis"@nl ;
    jas:codeWaarde "MEANING_TERM" .

<urn:jas-ns:code:NOMINALIZED_ACTION> a jas:Detectiecode ;
    skos:definition "'Het indienen van', 'de dagtekening van': een handeling of gebeurtenis als naamwoord."@nl ;
    skos:prefLabel "Handeling als zelfstandig naamwoord"@nl ;
    jas:codeWaarde "NOMINALIZED_ACTION" .

<urn:jas-ns:code:NORMATIVE_PREDICATE> a jas:Detectiecode ;
    skos:definition "'Is verplicht', 'kan', 'heeft recht op', 'is bevoegd': een recht of plicht."@nl ;
    skos:prefLabel "Normatief gezegde"@nl ;
    jas:codeWaarde "NORMATIVE_PREDICATE" .

<urn:jas-ns:code:OBJECT_NP> a jas:Detectiecode ;
    skos:definition "Een naamwoordgroep als voorwerp bij een normatief gezegde."@nl ;
    skos:prefLabel "Voorwerp bij een recht of plicht"@nl ;
    jas:codeWaarde "OBJECT_NP" .

<urn:jas-ns:code:PARAMETER_NOUN> a jas:Detectiecode ;
    skos:definition "'Tarief', 'drempel', 'vrijstelling': een woord dat een vaste waarde benoemt."@nl ;
    skos:prefLabel "Parameterwoord"@nl ;
    jas:codeWaarde "PARAMETER_NOUN" .

<urn:jas-ns:code:PERSON_PRONOUN> a jas:Detectiecode ;
    skos:definition "'Hij', 'degene', 'een ieder': een voornaamwoord dat naar een persoon verwijst."@nl ;
    skos:prefLabel "Verwijzend voornaamwoord"@nl ;
    jas:codeWaarde "PERSON_PRONOUN" .

<urn:jas-ns:code:PRIORITY_APPLIED> a jas:Detectiecode ;
    skos:definition "Een specifiekere klasse ging voor op een algemenere, volgens de JAS-voorrangsregels."@nl ;
    skos:prefLabel "Voorrangsregel toegepast"@nl ;
    jas:codeWaarde "PRIORITY_APPLIED" .

<urn:jas-ns:code:PROPERTY_NOUN> a jas:Detectiecode ;
    skos:definition "'De hoogte van', 'het bedrag van': een naamwoordgroep die een eigenschap noemt."@nl ;
    skos:prefLabel "Eigenschap"@nl ;
    jas:codeWaarde "PROPERTY_NOUN" .

<urn:jas-ns:code:RESTRICTIVE_RELATIVE> a jas:Detectiecode ;
    skos:definition "Een betrekkelijke bijzin die de groep beperkt ('die …', 'waarvan …') – vaak een voorwaarde."@nl ;
    skos:prefLabel "Beperkende bijzin"@nl ;
    jas:codeWaarde "RESTRICTIVE_RELATIVE" .

<urn:jas-ns:code:SUBJECT_NP> a jas:Detectiecode ;
    skos:definition "Het onderwerp van een zin met een normatief gezegde – vaak de drager van het recht of de plicht."@nl ;
    skos:prefLabel "Onderwerp bij een recht of plicht"@nl ;
    jas:codeWaarde "SUBJECT_NP" .

<urn:jas-ns:regel:JAS-PRIORITY-001> a jas:Methoderegel ;
    skos:definition "Indien een formulering zowel als tijdsaanduiding als variabele of parameter kan worden geclassificeerd, prevaleert tijdsaanduiding als de meest specifieke klasse."@nl ;
    skos:prefLabel "JAS-PRIORITY-001" ;
    jas:geldtVoor <urn:jas-ns:klasse:ParameterEnParameterwaarde>,
        <urn:jas-ns:klasse:Tijdsaanduiding>,
        <urn:jas-ns:klasse:VariabeleEnVariabelewaarde> ;
    jas:regelType "priority" .

<urn:jas-ns:regel:JAS-PRIORITY-002> a jas:Methoderegel ;
    skos:definition "Indien een formulering zowel als plaatsaanduiding als variabele of parameter kan worden geclassificeerd, prevaleert plaatsaanduiding als de meest specifieke klasse."@nl ;
    skos:prefLabel "JAS-PRIORITY-002" ;
    jas:geldtVoor <urn:jas-ns:klasse:ParameterEnParameterwaarde>,
        <urn:jas-ns:klasse:Plaatsaanduiding>,
        <urn:jas-ns:klasse:VariabeleEnVariabelewaarde> ;
    jas:regelType "priority" .

<urn:jas-ns:regel:jas.afleiding.bedraagt> a jas:Detectorregel ;
    dcterms:source "H2:73" ;
    skos:prefLabel "Berekening met 'bedraagt'"@nl ;
    jas:code <urn:jas-ns:code:CALCULATION_COPULA> ;
    jas:regelVersie 1 ;
    jas:wijstAan <urn:jas-ns:klasse:Afleidingsregel>,
        <urn:jas-ns:klasse:ParameterEnParameterwaarde> .

<urn:jas-ns:regel:jas.afleiding.fictie_vermoeden> a jas:Detectorregel ;
